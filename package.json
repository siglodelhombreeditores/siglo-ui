{
  "name": "@siglo/ui",
  "description": "Funcionalidades PrestaShop themes Siglo",
  "author": "Siglo",
  "license": "ISC",
  "version": "0.3.0",
  "type": "module",
  "sideEffects": ["*.scss", "*.css"],
  "style": "scss/_index.scss",
  "sass": "scss/_index.scss",
  "exports": {
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "default": "./src/services/index.ts"
    },
    "./styles": {
      "sass": "./styles/_index.scss",
      "default": "./styles/_index.scss"
    },
    "./styles/*": "./styles/*.scss",
    "./package.json": "./package.json"
  },
  "files": ["src", "styles", "components", "services"],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "peerDependencies": {
    "@types/bootstrap": ">=5.0.0",
    "bootstrap": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@types/bootstrap": { "optional": true }
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.11"
  }
}
